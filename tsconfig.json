{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["packages/react/*/src", "packages/react/*/tests", "packages/react/*/vitest.config.ts", "apps/react/*/src", "vitest.config.ts"]
}
